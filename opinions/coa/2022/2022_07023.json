{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2022_07023","path":"opinions/coa/2022/2022_07023.htm","publicationStatus":"published"},"header":{"title":"People v Cruz","slipOpinion":"2022 NY Slip Op 07023 [39 NY3d 973]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**39 NY3d at 973}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**39 NY3d at 973}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), order reversed and accusatory instrument dismissed. As the People acknowledge, the accusatory instrument's misdemeanor count, to which defendant pleaded guilty, was facially deficient ("},{"type":"link","href":"../2022/2022_03930.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"see People v Hill"}]},{"type":"text","text":", 38 NY3d 460"}]},{"type":"text","text":", 462 [2022]). The People consent to dismissal of the remaining portion of the accusatory instrument."},{"type":"text","text":" "},{"type":"text","text":"Concur: Acting Chief Judge Cannataro and Judges Rivera, Garcia, Wilson, Singas and Troutman."}],"provenance":{"startLine":7,"endLine":13}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
