{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2022_03308","path":"opinions/coa/2022/2022_03308.htm","publicationStatus":"published"},"header":{"title":"People v McKenzie-Smith","slipOpinion":"2022 NY Slip Op 03308 [38 NY3d 1048]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**38 NY3d at 1048}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**38 NY3d at 1048}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), order reversed and case remitted to the Appellate Division, Fourth"},{"type":"text","text":"{**38 NY3d at 1049}"},{"type":"text","text":" Department, for consideration of the facts and issues raised but not determined on appeal to that Court. The Appellate Division erred in holding that defendant's "},{"type":"emphasis","children":[{"type":"text","text":"Antommarchi"}]},{"type":"text","text":" claim ("},{"type":"emphasis","children":[{"type":"text","text":"People v Antommarchi"}]},{"type":"text","text":", 80 NY2d 247 [1992]) entitled him to a new trial ("},{"type":"link","href":"../2021/2021_06936.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"see People v Wilkins"}]},{"type":"text","text":", 37 NY3d 371"}]},{"type":"text","text":", 380 [2021])."},{"type":"text","text":" "},{"type":"text","text":"Concur: Chief Judge DiFiore and Judges Rivera, Garcia, Wilson, Singas and Cannataro. Judge Troutman took no part."}],"provenance":{"startLine":7,"endLine":13}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
