{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2007_03595","path":"opinions/coa/2007/2007_03595.htm","publicationStatus":"published"},"header":{"title":"People v Miller","slipOpinion":"2007 NY Slip Op 03595 [8 NY3d 937]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**8 NY3d at 938}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Order affirmed. Defendant's argument that he did not receive a hearing in accordance with due process of law is unpreserved for our review. We do not accept defendant's contention that the error here, if any, constitutes a mode of proceedings error. "},{"type":"text","text":" "},{"type":"text","text":"Concur: Chief Judge Kaye and Judges Ciparick, Graffeo, Read, Smith, Pigott and Jones. "},{"type":"text","text":" "}],"provenance":{"startLine":7,"endLine":11}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
