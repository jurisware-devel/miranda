{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2017_07299","path":"../miranda/opinions/coa/2017/2017_07299.htm","publicationStatus":"published"},"header":{"title":"People v Carr","slipOpinion":"2017 NY Slip Op 07299","officialCitation":"30 NY3d 945","court":"Court of Appeals","decisionDate":"2017-10-19"},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"page_marker","text":"{**30 NY3d at 946}","citation":"30 NY3d at 946"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"page_marker","text":"{**30 NY3d at 946}","citation":"30 NY3d at 946"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"There was no error in the denial of defendant's motion to vacate the judgment. Under these circumstances, the People were not required to seek court permission under CPL 190.75 (3) before presenting additional charges to a second grand jury. We do not pass upon "},{"type":"text","text":"whether a CPL 440.10 motion lies to bring this claim, as that question is not before us."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge DiFiore and Judges Rivera, Stein, Garcia, Wilson and Feinman concur; Judge Fahey taking no part."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":19}}]}],"footnotes":[],"disposition":{"text":"Order affirmed, in a memorandum.","provenance":{"startLine":19,"endLine":19}},"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}