{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2025_05736","path":"opinions/coa/2025/2025_05736.htm","publicationStatus":"published"},"header":{"title":null,"slipOpinion":"2025 NY Slip Op 05736 [44 NY3d 1040]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**44 NY3d at 1040}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**44 NY3d at 1040}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Judgment affirmed, without costs. The Appellate Division did not abuse its discretion in dismissing as moot so much of the petition as sought defendant's immediate release. Insofar as the petition sought other relief, the petition is now moot, and we decline to apply the mootness exception."},{"type":"text","text":" "},{"type":"text","text":"Concur: Chief Judge Wilson and Judges Rivera, Garcia, Singas, Cannataro, Troutman and Halligan."}],"provenance":{"startLine":7,"endLine":13}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
