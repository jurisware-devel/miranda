{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2012_07860","path":"../miranda/opinions/coa/2012/2012_07860.htm","publicationStatus":"published"},"header":{"title":"People v Torres","slipOpinion":"2012 NY Slip Op 07860","officialCitation":"20 NY3d 890","court":"Court of Appeals","decisionDate":"2012-11-20"},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"page_marker","text":"{**20 NY3d at 891}","citation":"20 NY3d at 891"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum. "},{"type":"text","text":" "},{"type":"text","text":"The orders of the Appellate Division should be affirmed. "},{"type":"text","text":" "},{"type":"text","text":"Defendant adequately preserved the argument that the exclusion of his wife from "},{"type":"text","text":"the courtroom violated his right to a public trial ("},{"type":"emphasis","children":[{"type":"text","text":"see People v Alvarez"}]},{"type":"text","text":", 20 NY3d 75, 81 [2012]; "},{"type":"link","href":"../2010/2010_02674.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"see also People v Caban"}]},{"type":"text","text":", 14 NY3d 369"}]},{"type":"text","text":", 373 [2010]). The closure of the courtroom during jury selection was not trivial ("},{"type":"link","href":"../2011/2011_03885.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"see People v Martin"}]},{"type":"text","text":", 16 NY3d 607"}]},{"type":"text","text":", 613 [2011]). "},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Lippman and Judges Ciparick, Graffeo, Read, Smith and Pigott concur. "},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), orders affirmed in a memorandum. "},{"type":"text","text":" "}],"provenance":{"startLine":7,"endLine":17}}]}],"footnotes":[],"disposition":{"text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), orders affirmed in a memorandum.","provenance":{"startLine":17,"endLine":17}},"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
