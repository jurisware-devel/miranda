{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2024_06237","path":"opinions/coa/2024/2024_06237.htm","publicationStatus":"published"},"header":{"title":"People v Watkins","slipOpinion":"2024 NY Slip Op 06237 [42 NY3d 1074]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**42 NY3d at 1074}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**42 NY3d at 1074}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"The argument defendant raises on this appeal, whether the initial stop of defendant constituted a level four encounter with police, is unpreserved for our review ("},{"type":"emphasis","children":[{"type":"text","text":"see "}]},{"type":"text","text":"CPL 470.05 [2]; "},{"type":"link","href":"../2015/2015_03767.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"People v Graham"}]},{"type":"text","text":", 25 NY3d 994"}]},{"type":"text","text":", 996-997 [2015]; "},{"type":"emphasis","children":[{"type":"text","text":"see generally People v De Bour"}]},{"type":"text","text":", 40 NY2d 210 [1976])."},{"type":"text","text":"{**42 NY3d at 1075}"},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Wilson and Judges Rivera, Garcia, Singas, Cannataro, Troutman and Halligan concur."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":19}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"deb