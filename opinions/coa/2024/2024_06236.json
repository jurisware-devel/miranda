{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2024_06236","path":"../miranda/opinions/coa/2024/2024_06236.htm","publicationStatus":"published"},"header":{"title":"People v Garcia","slipOpinion":"2024 NY Slip Op 06236","officialCitation":"42 NY3d 1077","court":"Court of Appeals","decisionDate":"2024-12-12"},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"page_marker","text":"{**42 NY3d at 1077}","citation":"42 NY3d at 1077"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"page_marker","text":"{**42 NY3d at 1077}","citation":"42 NY3d at 1077"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"Defendant's argument that the showup identification procedure was unduly suggestive because of its collective nature—defendant was presented for identification alongside his two codefendants—and, specifically, that the strength of the victim's identification as to one of the codefendants infected the identification of defendant is unpreserved ("},{"type":"emphasis","children":[{"type":"text","text":"see "}]},{"type":"text","text":"CPL 470.05 [2]; "},{"type":"link","href":"../2016/2016_02281.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"cf. People v Cedeno"}]},{"type":"text","text":", 27 NY3d 110"}]},{"type":"text","text":", 123 n 3 [2016]). Defendant's remaining arguments lack merit."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Wilson and Judges Rivera, Garcia, Singas, Cannataro, Troutman and Halligan concur."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":19}}]}],"footnotes":[],"disposition":{"text":"Order affirmed, in a memorandum.","provenance":{"startLine":19,"endLine":19}},"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}