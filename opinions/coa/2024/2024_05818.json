{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2024_05818","path":"../miranda/opinions/coa/2024/2024_05818.htm","publicationStatus":"published"},"header":{"title":"People v Williams","slipOpinion":"2024 NY Slip Op 05818","officialCitation":"42 NY3d 1049","court":"Court of Appeals","decisionDate":"2024-11-21"},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"page_marker","text":"{**42 NY3d at 1049}","citation":"42 NY3d at 1049"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"page_marker","text":"{**42 NY3d at 1049}","citation":"42 NY3d at 1049"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"Assuming, without deciding, that the introduction of codefendant's statement was a "},{"type":"emphasis","children":[{"type":"text","text":"Bruton"}]},{"type":"text","text":" error ("},{"type":"emphasis","children":[{"type":"text","text":"see Bruton v United States"}]},{"type":"text","text":", 391 US 123 [1968]), any such error was harmless. The evidence of defendant's guilt, specifically the incriminating testimony of two acquaintances who were eyewitnesses to the"},{"type":"page_marker","text":"{**42 NY3d at 1050}","citation":"42 NY3d at 1050"},{"type":"text","text":" crime, was overwhelming and there is no reasonable possibility that the admission of codefendant's statement affected the verdict ("},{"type":"link","href":"../2016/2016_02281.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"see People v Cedeno"}]},{"type":"text","text":", 27 NY3d 110"}]},{"type":"text","text":", 121-122 [2016]; "},{"type":"link","href":"../2005/2005_01263.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"People v Hardy"}]},{"type":"text","text":", 4 NY3d 192"}]},{"type":"text","text":", 198 [2005]; "},{"type":"emphasis","children":[{"type":"text","text":"People v Crimmins"}]},{"type":"text","text":", 36 NY2d 230, 241 [1975])."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Wilson and Judges Rivera, Garcia, Singas, Cannataro, Troutman and Halligan concur."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":6,"endLine":18}}]}],"footnotes":[],"disposition":{"text":"Order affirmed, in a memorandum.","provenance":{"startLine":18,"endLine":18}},"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
