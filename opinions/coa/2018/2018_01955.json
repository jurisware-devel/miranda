{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2018_01955","path":"opinions/coa/2018/2018_01955.htm","publicationStatus":"published"},"header":{"title":"People v Johnson","slipOpinion":"2018 NY Slip Op 01955 [31 NY3d 942]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**31 NY3d at 943}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**31 NY3d at 943}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The Appellate Division order should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"Defendant Michael Johnson appeals from the Appellate Division order affirming two judgments of conviction and sentence. On the facts of this case, assuming without deciding that the trial court erroneously denied defendant's motion to suppress, any such error was harmless ("},{"type":"emphasis","children":[{"type":"text","text":"see People v Crimmins"}]},{"type":"text","text":", 36 NY2d 230 [1975]). Defendant's other claims of trial error and prosecutorial misconduct are without merit ("},{"type":"emphasis","children":[{"type":"text","text":"see"}]},{"type":"text","text":" CPL 240.50; "},{"type":"emphasis","children":[{"type":"text","text":"People v Almodovar"}]},{"type":"text","text":", 62 NY2d 126, 133 [1984]; "},{"type":"emphasis","children":[{"type":"text","text":"People v Davis"}]},{"type":"text","text":", 58 NY2d 1102, 1104 [1983])."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge DiFiore and Judges Rivera, Stein, Fahey, Garcia, Wilson and Feinman concur."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":19}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
