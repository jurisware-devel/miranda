{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2014_08058","path":"opinions/coa/2014/2014_08058.htm","publicationStatus":"unknown"},"header":{"title":"People v Caza","slipOpinion":null,"officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**24 NY3d at 1057}"},{"type":"text","text":"OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**24 NY3d at 1057}"},{"type":"text","text":"OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed. Defendant's argument that County Court erred in enhancing her sentence by departing from its conditional promise to make her two terms of imprisonment run concurrently is unpreserved for our review ("},{"type":"emphasis","children":[{"type":"text","text":"see"}]},{"type":"text","text":" CPL "},{"type":"text","text":"470.05 [2]; "},{"type":"link","href":"../2008/2008_09254.htm","children":[{"type":"emphasis","children":[{"type":"text","text":"People v Hawkins"}]},{"type":"text","text":", 11 NY3d 484"}]},{"type":"text","text":", 491-493 [2008])."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Lippman and Judges Graffeo, Read, Smith, Pigott, Rivera and Abdus-Salaam concur."},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":17}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":false,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
