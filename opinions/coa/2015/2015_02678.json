{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2015_02678","path":"opinions/coa/2015/2015_02678.htm","publicationStatus":"published"},"header":{"title":"People v Anthony C.","slipOpinion":"2015 NY Slip Op 02678 [25 NY3d 937]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**25 NY3d at 938}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**25 NY3d at 938}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed. The Appellate Division opinion does not suggest a misapprehension or misapplication of its authority to review youthful offender adjudications for abuse of discretion (CPL 720.20 [1] [a]), or under its broad interest-of-justice jurisdiction ("},{"type":"emphasis","children":[{"type":"text","text":"see"}]},{"type":"text","text":" CPL 470.15 [6] [b]; "},{"type":"emphasis","children":[{"type":"text","text":"People v Dawn Maria C."}]},{"type":"text","text":", 67 NY2d 625, 627 [1986])."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Lippman and Judges Read, Pigott, Rivera, Abdus-Salaam, Stein and Fahey concur."},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":17}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
