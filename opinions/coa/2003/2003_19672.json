{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2003_19672","path":"opinions/coa/2003/2003_19672.htm","publicationStatus":"published"},"header":{"title":"People v Santos","slipOpinion":"2003 NY Slip Op 19672 [1 NY3d 548]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum. "},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed. "},{"type":"text","text":" "},{"type":"text","text":"The Court here lacks power to review the lower courts' exercise of discretion in vacating the criminal conviction and granting a new trial on the basis of newly discovered evidence ("},{"type":"emphasis","children":[{"type":"text","text":"People v Baxley"}]},{"type":"text","text":", 84 NY2d 208, 212 [1994]; "},{"type":"emphasis","children":[{"type":"text","text":"People v Fields"}]},{"type":"text","text":", 66 NY2d 876, 878 [1985]). "},{"type":"text","text":" "},{"type":"text","text":"Chief Judge Kaye and Judges G.B. Smith, Ciparick, Rosenblatt, Graffeo and Read concur. "},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.4 of the Rules of the Court of Appeals (22 NYCRR 500.4), order affirmed in a memorandum. "},{"type":"text","text":" "}],"provenance":{"startLine":7,"endLine":17}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
