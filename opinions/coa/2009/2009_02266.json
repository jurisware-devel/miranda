{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2009_02266","path":"opinions/coa/2009/2009_02266.htm","publicationStatus":"published"},"header":{"title":"People v Lowe","slipOpinion":"2009 NY Slip Op 02266 [12 NY3d 768]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**12 NY3d at 768}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum. "},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":"{**12 NY3d at 769}"},{"type":"text","text":" "},{"type":"text","text":" "},{"type":"text","text":"The lower courts' determinations of probable cause, a mixed question of law and "},{"type":"text","text":"fact, are supported by the minutes of the in camera hearing conducted pursuant to "},{"type":"emphasis","children":[{"type":"text","text":"People v Darden"}]},{"type":"text","text":" (34 NY2d 177 [1974]), and are thus beyond our further review. Accordingly, defendant's motion to suppress was properly denied. "},{"type":"text","text":" "},{"type":"text","text":"We have considered defendant's remaining contentions and find them to be without merit. "},{"type":"text","text":" "},{"type":"text","text":"Judges Ciparick, Graffeo, Read, Smith, Pigott and Jones concur; Chief Judge Lippman taking no part. "},{"type":"text","text":" "},{"type":"text","text":"Order affirmed in a memorandum. "},{"type":"text","text":" "}],"provenance":{"startLine":7,"endLine":19}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
