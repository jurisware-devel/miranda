{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2020_06839","path":"opinions/coa/2020/2020_06839.htm","publicationStatus":"published"},"header":{"title":"People v Smith","slipOpinion":"2020 NY Slip Op 06839 [35 NY3d 1117]","officialCitation":null,"court":"Court of Appeals","decisionDate":null},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"text","text":"{**35 NY3d at 1117}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"{**35 NY3d at 1117}"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"On review of submissions pursuant to section 500.11 of the Rules of the Court of Appeals (22 NYCRR 500.11), order reversed and case remitted to Supreme Court, Bronx County, for a hearing on defendant's CPL 330.30 motion. The motion court abused its discretion in denying defendant's CPL 330.30 (2) motion without first conducting a hearing ("},{"type":"emphasis","children":[{"type":"text","text":"see"}]},{"type":"text","text":" CPL 330.40 [2] [d]-[f]; "},{"type":"emphasis","children":[{"type":"text","text":"People v Maragh"}]},{"type":"text","text":", 94 NY2d 569, 573-575 [2000]). Concur: Chief Judge DiFiore and Judges Rivera, Stein, Fahey, Garcia, Wilson and Feinman."}],"provenance":{"startLine":7,"endLine":11}}]}],"footnotes":[],"disposition":null,"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}
