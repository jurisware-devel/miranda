{"version":"0.1","documentType":"opinion","source":{"kind":"lrb_html","caseId":"2016_05181","path":"../miranda/opinions/coa/2016/2016_05181.htm","publicationStatus":"published"},"header":{"title":"People v Panton","slipOpinion":"2016 NY Slip Op 05181","officialCitation":"27 NY3d 1144","court":"Court of Appeals","decisionDate":"2016-06-30"},"appearances":[],"opinions":[{"kind":"majority","author":null,"label":null,"joiners":[],"blocks":[{"type":"paragraph","inlines":[{"type":"page_marker","text":"{**27 NY3d at 1144}","citation":"27 NY3d at 1144"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"page_marker","text":"{**27 NY3d at 1144}","citation":"27 NY3d at 1144"},{"type":"text","text":" OPINION OF THE COURT"},{"type":"text","text":" "},{"type":"text","text":"Memorandum."},{"type":"text","text":" "},{"type":"text","text":"The order of the Appellate Division should be affirmed."},{"type":"text","text":" "},{"type":"text","text":"Defendant contends that police engaged in improper pre-"},{"type":"emphasis","children":[{"type":"text","text":"Miranda"}]},{"type":"text","text":" custodial interrogation and, as a result, her post-"},{"type":"page_marker","text":"{**27 NY3d at 1145}","citation":"27 NY3d at 1145"},{"type":"emphasis","children":[{"type":"text","text":"Miranda"}]},{"type":"text","text":" written and video statements should have been suppressed. Because defendant did "},{"type":"text","text":"not raise this particular ground either in her suppression motion or at the hearing, it is unpreserved for our review ("},{"type":"emphasis","children":[{"type":"text","text":"see People v Gonzalez"}]},{"type":"text","text":", 55 NY2d 887, 888 [1982])."},{"type":"text","text":" "},{"type":"text","text":"We have considered defendant's remaining contention and find it to be without merit."},{"type":"text","text":" "},{"type":"text","text":"Chief Judge DiFiore and Judges Pigott, Rivera, Abdus-Salaam, Stein, Fahey and Garcia concur."},{"type":"text","text":" "},{"type":"text","text":"Order affirmed, in a memorandum."}],"provenance":{"startLine":7,"endLine":21}}]}],"footnotes":[],"disposition":{"text":"Order affirmed, in a memorandum.","provenance":{"startLine":21,"endLine":21}},"renderingHints":{"hasOfficialPageMarkers":true,"hasAppearances":false,"hasFootnotes":false,"hasSeparateOpinions":false},"debug":{"diagnostics":[]}}